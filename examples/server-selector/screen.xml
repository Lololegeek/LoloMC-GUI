<screen id="server-screen" class="app-shell">
  <panel class="sidebar">
    <label class="logo">LOLOMC</label>
    <label class="muted">SERVEURS</label>
    <button class="nav active">Discover</button>
    <button class="nav">Favorites</button>
    <spacer flex="1" />
    <label class="muted">Signed in as Loevan</label>
  </panel>
  <panel class="content">
    <label class="eyebrow">MULTIPLAYER</label>
    <label class="title">Choose a world</label>
    <input id="search" placeholder="Search..." on-change="filterServers" />
    <panel class="featured">
      <label class="eyebrow">FEATURED</label>
      <label class="server-name">LoloCraft Origins</label>
      <label class="muted">Survival, economy, and adventures.</label>
      <button id="join" class="primary" on-click="joinServer">Join server</button>
    </panel>
  </panel>
</screen>
