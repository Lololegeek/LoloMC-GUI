<screen id="example-screen" class="screen">
  <panel id="card" class="card">
    <panel class="topline">
      <panel class="brandmark"><label>✦</label></panel>
      <panel class="brandcopy">
        <label class="eyebrow">LOLOMC GUI • FABRIC EXAMPLE</label>
        <label class="microcopy">XML + CSS, directly in game</label>
      </panel>
      <badge class="status">LIVE</badge>
    </panel>
    <label class="title">A real in-game GUI</label>
    <label class="copy">Responsive, polished, and customizable with XML + CSS.</label>
    <input id="name" placeholder="Your username" on-change="nameChanged" />
    <progress class="progress" value="0.72" max="1" />
    <panel class="actions">
      <button id="play" class="primary" on-click="play">Play now</button>
      <button id="close" class="secondary" on-click="close">Close</button>
    </panel>
    <label class="footnote">Press O to reopen this demo</label>
  </panel>
</screen>
